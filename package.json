{
  "name": "pizzeria-santa-chiara",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site da Pizzeria Santa Chiara (Lisboa) — menu real e fluxo de pedido",
  "scripts": {
    "qa": "node tools/qa.mjs index.html",
    "qa:browser": "node tools/browser-test.mjs",
    "test:deploy": "node --test tools/deploy-vercel.test.mjs",
    "test": "npm run qa && npm run test:deploy && npm run qa:browser",
    "build": "bash build.sh",
    "deploy": "node tools/deploy-vercel.mjs",
    "serve": "python3 -m http.server 8000 --bind 0.0.0.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "playwright-core": "1.49.1"
  }
}
