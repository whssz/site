{
  "framework": null,
  "installCommand": "echo \"site pré-montado: nada a instalar\"",
  "buildCommand": "echo \"site pré-montado em public/\"",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
